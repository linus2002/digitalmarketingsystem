# ---------------------------------------------------------------
# Copy this file to .env and fill it in. Never commit .env.
# Generate secrets with:  npm run gen:keys
# ---------------------------------------------------------------

NODE_ENV=development
HOST=127.0.0.1
PORT=4000

# PostgreSQL connection
DATABASE_URL=postgres://dm_app:change-me@localhost:5432/digitmarketing

# Security (REQUIRED). JWT_SECRET >= 32 chars; DATA_ENCRYPTION_KEY = 64 hex chars.
# Losing DATA_ENCRYPTION_KEY makes encrypted contact details unreadable: back it up safely.
JWT_SECRET=
DATA_ENCRYPTION_KEY=
SESSION_HOURS=10
# Set to true when served over HTTPS
COOKIE_SECURE=false
# Set to true when running behind a reverse proxy (nginx, Caddy, IIS ARR). Sign-in rate limits are per IP,
# so without this every visitor shares the proxy's address. (Limits are kept in memory per app process.)
TRUST_PROXY=false

# Where the React app runs (dev). In production the API serves the built client itself.
CLIENT_ORIGIN=http://localhost:5190
# Websites allowed to post to the public inquiry form API (comma-separated)
PUBLIC_FORM_ORIGINS=http://localhost:5190
# Shown in the Messenger consent message
PRIVACY_POLICY_URL=https://www.example.com/privacy
BUSINESS_NAME=GetMeds

# First admin account (created by `npm run db:setup` only when there are no users)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
ADMIN_NAME=Administrator

# AI provider: "anthropic" (Claude, recommended; the default when unset, needs ANTHROPIC_API_KEY)
# or "ollama" (local model, no cloud)
AI_PROVIDER=anthropic
# From console.anthropic.com > API keys
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
AI_TIMEOUT_MS=120000
# May inquiry text (health-related personal data) be sent to the AI for sorting and reply suggestions?
# Leave empty for the safe default: yes for local Ollama, NO for Claude. Set true only after your
# privacy review covers sending inquiry data to Anthropic.
AI_FOR_INQUIRIES=

# Local AI (only used when AI_PROVIDER=ollama)
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_TIMEOUT_MS=180000
# Optional: an API key from ollama.com (Settings > Keys) turns on Ollama web search, which looks up why each
# Google trend is trending. Only the trending search terms are sent, never inquiry data. Switch it on in Settings > Trend sources.
OLLAMA_API_KEY=

# Meta / Facebook (from developers.facebook.com, your app > Settings)
META_GRAPH_VERSION=v23.0
META_APP_SECRET=
# Any random string; type the same value into the Messenger webhook settings in the Meta app
META_VERIFY_TOKEN=
# Page ID and Page access token can also be entered in Settings > Facebook connection (stored encrypted)
META_PAGE_ID=
META_PAGE_ACCESS_TOKEN=
# Only enable if your app has been approved for the human_agent permission
META_ENABLE_HUMAN_AGENT_TAG=false
# Metric names change between Graph API versions; unsupported ones are skipped and reported
META_POST_METRICS=post_impressions,post_impressions_unique,post_clicks,post_media_view,post_total_media_view_unique
META_PAGE_METRICS=page_impressions_unique,page_post_engagements,page_follows,page_media_view,page_total_media_view_unique,page_views_total

# Test mode: posts and Messenger replies are logged instead of sent to Facebook.
# Both default to true when unset; set to false only when you're ready to go live.
PUBLISH_DRY_RUN=true
MESSENGER_DRY_RUN=true

# Other social platforms (Instagram, X, YouTube, TikTok, LinkedIn) are connected in Settings -> Social accounts.
# This system's public https address. Instagram downloads uploaded images/videos from it, and Google, TikTok
# and LinkedIn send people back to <PUBLIC_BASE_URL>/api/oauth/<platform>/callback after "Connect".
# Leave empty during development (sign-in callbacks then use CLIENT_ORIGIN).
PUBLIC_BASE_URL=

# Background jobs
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_SECONDS=30
ANALYTICS_SYNC_HOURS=6
# Rescan trends (incl. live Google trends) every N minutes; 0 = manual only
TRENDS_AUTO_REFRESH_MINUTES=30

# Optional trend sources
NEWSAPI_KEY=
NCBI_API_KEY=
